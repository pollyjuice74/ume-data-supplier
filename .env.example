SUPPLIER_HOST=0.0.0.0
SUPPLIER_PORT=8090
SUPPLIER_PUBLIC_URL=http://localhost:8090
SUPPLIER_ENABLE_LIVE=true
SUPPLIER_QUEUE_SIZE=256
SUPPLIER_STALE_AFTER_SECONDS=30
SUPPLIER_RPC_URL=http://host.docker.internal:8545
SUPPLIER_CHAIN_ID=31337
SUPPLIER_FEED_ACCESS_ADDRESS=
SUPPLIER_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional. Registration is disabled until UME provides an external-live-listing API.
SUPPLIER_UME_API_URL=http://host.docker.internal:8000
SUPPLIER_SELLER_PRIVATE_KEY=

