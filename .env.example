SUPPLIER_HOST=0.0.0.0
SUPPLIER_PORT=8090
# Northflank: https://p01--ume-data-supplier-service1--4bt4m287psw5.code.run
SUPPLIER_PUBLIC_URL=http://localhost:8090
SUPPLIER_ENABLE_LIVE=true
# Exchange collectors are unrelated to the paid wallet products and are opt-in.
SUPPLIER_ENABLE_EXCHANGE_FEEDS=false
SUPPLIER_QUEUE_SIZE=64
SUPPLIER_RATE_WINDOW_MAX_EVENTS=4096
SUPPLIER_STALE_AFTER_SECONDS=30
SUPPLIER_RPC_URL=http://host.docker.internal:8545
# Payment/entitlement network (Ethereum Sepolia for the current KPM beta).
SUPPLIER_CHAIN_ID=11155111
# Current Account 2-owned Sepolia deployment. This is TEST USDC only.
SUPPLIER_FEED_ACCESS_ADDRESS=0x1e917c8a8bc40bc529f59103c1c9b2e293d2a743
SUPPLIER_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional. Registration is disabled until UME provides an external-live-listing API.
SUPPLIER_UME_API_URL=http://host.docker.internal:8000
SUPPLIER_SELLER_PRIVATE_KEY=
# The tunnel launcher overrides PUBLIC_URL and includes the hosted UME origin in CORS.
SUPPLIER_OWNER_WALLET=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
SUPPLIER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kpm-intake-web.onrender.com
# Northflank must mount a persistent volume at /app/data.
SUPPLIER_DATABASE_PATH=/app/data/supplier.sqlite3
SUPPLIER_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
SUPPLIER_ETHEREUM_FALLBACK_RPC_URLS=
# WebSocket providers are the low-latency trigger; HTTP remains the canonical
# verifier and gap/reorg recovery path. Use provider secrets in Northflank,
# never in this file or Git.
SUPPLIER_ETHEREUM_WS_URL=
SUPPLIER_ETHEREUM_FALLBACK_WS_URLS=
SUPPLIER_ETHEREUM_RECONCILE_SECONDS=30
# Pending transactions are provider-dependent and predictions only. Disabled
# by default; confirmed signals continue to come from canonical logs.
SUPPLIER_ETHEREUM_PENDING_TRANSACTIONS=false
SUPPLIER_ETHEREUM_RETRY_MAX_SECONDS=60
SUPPLIER_ETHEREUM_POLL_SECONDS=12
SUPPLIER_ETHEREUM_CONFIRMATIONS=2
SUPPLIER_ETHEREUM_BACKFILL_BLOCKS=2
SUPPLIER_RETENTION_DAYS=14
SUPPLIER_MAX_EVENTS=250000
SUPPLIER_EXPORT_MAX_ROWS=10000
# FeedAccess must report this exact fee. Treasury wallet is read from the contract.
SUPPLIER_EXPECTED_PROTOCOL_FEE_BPS=250
