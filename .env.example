SUPPLIER_HOST=0.0.0.0
SUPPLIER_PORT=8090
SUPPLIER_PUBLIC_URL=http://localhost:8090
SUPPLIER_ENABLE_LIVE=true
SUPPLIER_QUEUE_SIZE=256
SUPPLIER_STALE_AFTER_SECONDS=30
SUPPLIER_RPC_URL=http://host.docker.internal:8545
SUPPLIER_CHAIN_ID=31337
SUPPLIER_FEED_ACCESS_ADDRESS=
SUPPLIER_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional. Registration is disabled until UME provides an external-live-listing API.
SUPPLIER_UME_API_URL=http://host.docker.internal:8000
SUPPLIER_SELLER_PRIVATE_KEY=
# The tunnel launcher overrides PUBLIC_URL and includes the hosted UME origin in CORS.
SUPPLIER_OWNER_WALLET=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
SUPPLIER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Persistent, bounded Ethereum wallet feed (Oracle VM local disk).
SUPPLIER_DATABASE_PATH=./data/supplier.sqlite3
SUPPLIER_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
SUPPLIER_ETHEREUM_POLL_SECONDS=12
SUPPLIER_ETHEREUM_CONFIRMATIONS=2
SUPPLIER_ETHEREUM_BACKFILL_BLOCKS=2
SUPPLIER_RETENTION_DAYS=14
SUPPLIER_MAX_EVENTS=250000
SUPPLIER_EXPORT_MAX_ROWS=50000
# FeedAccess must report this exact fee. Treasury wallet is read from the contract.
SUPPLIER_EXPECTED_PROTOCOL_FEE_BPS=250
