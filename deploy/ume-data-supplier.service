[Unit]
Description=UME authenticated blockchain data supplier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ume
Group=ume
WorkingDirectory=/opt/ume-data-supplier
EnvironmentFile=/etc/ume-data-supplier.env
ExecStart=/opt/ume-data-supplier/.venv/bin/uvicorn supplier.app:app --host 0.0.0.0 --port 8090 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ume-data-supplier/data
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
